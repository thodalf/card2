{
  "rules": {
    // ── Per-user data — decks, collection, economy, stats, tombstones,
    // pseudo mirror. Nothing here is read by any user other than its owner
    // anywhere in the app, so it's fully private.
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        // Trading needs a proposer to see what their friend actually owns
        // before targeting specific cards — this is the one deliberate crack
        // in "fully private" above, scoped to collection only (not economy/
        // decks/stats) and only for an existing friend. Read access at a
        // deeper path adds to (never replaces) the owner-only rule inherited
        // from above, so the owner's own access is unaffected.
        "collection": {
          ".read": "auth != null && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).exists())"
        }
      }
    },

    // ── Username uniqueness index (usernames/{normalizedPseudo}: uid).
    // Read must stay open to any authenticated user — sendFriendRequest()
    // resolves a typed-in pseudo to a uid before anyone is "friends" yet.
    // Write is restricted so a slot can only be claimed while empty, and
    // only ever touched afterwards by the uid that already owns it
    // (covers both claimUsername's re-claim and its release-old-slot step).
    "usernames": {
      "$pseudo": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && data.val() === auth.uid))"
      }
    },

    // ── Friends — bidirectional. Accepting a request (respondFriendRequest)
    // and deleting an account (deleteAccountData) both need to write the
    // *other* person's friends/{otherUid}/{myUid} entry, so write allows
    // either side of the pair, not just the list owner. Only the owner can
    // read their own list. Shape is validated to keep a compromised/rogue
    // client from stuffing oversized junk into someone else's list.
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $friendUid)",
          ".validate": "newData.hasChildren(['pseudo','since']) && newData.child('pseudo').isString() && newData.child('pseudo').val().length <= 12 && newData.child('since').isNumber()"
        }
      }
    },

    // ── Friend request mailbox — sender writes into the recipient's
    // mailbox; recipient clears it on accept/decline. Only the recipient can
    // read the whole mailbox, but sendFriendRequest() also needs to read back
    // its own single entry (friendRequests/{toUid}/{fromUid}) to detect an
    // already-pending request before re-sending — without this nested rule
    // that read hits the parent's owner-only rule and throws PERMISSION_DENIED
    // for the sender, which is the "permission denied on add friend" bug.
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$fromUid": {
          ".read": "auth != null && auth.uid === $fromUid",
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $fromUid)",
          ".validate": "newData.hasChildren(['fromPseudo','at']) && newData.child('fromPseudo').isString() && newData.child('fromPseudo').val().length <= 12 && newData.child('at').isNumber()"
        }
      }
    },

    // ── Notifications — any authenticated user can drop a NEW notification
    // into someone else's mailbox (friend request, challenge, match
    // result); deleting an existing entry is allowed for anyone too (the
    // owner's own subscribeNotifications() prunes past-cap entries — see
    // firebase.js), but *rewriting* one's content is owner-only. Only the
    // owner reads their own mailbox. .validate constrains payload shape so
    // an authenticated attacker can't spam arbitrary/oversized junk into a
    // stranger's mailbox, can't spoof who a notification is "from" (fromUid/
    // byUid must match the actual writer), and — since a 'challenge'
    // notification carries a "join this room" action — can only be sent to
    // an existing friend, not blasted at arbitrary strangers. Those sender-
    // identity/friendship checks only apply on creation (data doesn't exist
    // yet) — an update that leaves fromUid/byUid/type unchanged (e.g. the
    // owner flipping read:true) skips them, since re-checking "is the owner
    // friends with themselves" against auth.uid on every read-receipt write
    // would otherwise permanently fail.
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$pushId": {
          ".write": "auth != null && (!data.exists() || auth.uid === $uid || newData.val() === null)",
          ".validate": "newData.val() === null || (newData.hasChildren(['type','at']) && newData.child('at').isNumber() && newData.child('type').val().matches(/^(friend_request|friend_accept|challenge|match_result|level_up|trade_offer|trade_accepted|trade_declined)$/) && (!newData.hasChild('fromUid') || newData.child('fromUid').val() === auth.uid || newData.child('fromUid').val() === data.child('fromUid').val()) && (!newData.hasChild('byUid') || newData.child('byUid').val() === auth.uid || newData.child('byUid').val() === data.child('byUid').val()) && (!newData.hasChild('fromPseudo') || newData.child('fromPseudo').val().length <= 12) && (!newData.hasChild('byPseudo') || newData.child('byPseudo').val().length <= 12) && (!newData.hasChild('code') || newData.child('code').val().matches(/^[A-HJ-NP-Z2-9]{6}$/)) && (!newData.hasChild('tradeId') || newData.child('tradeId').val().length <= 40) && ((newData.child('type').val() !== 'challenge' && newData.child('type').val() !== 'trade_offer') || data.exists() || root.child('friends').child($uid).child(auth.uid).exists()))"
        }
      }
    },

    // ── Push notification device tokens (fcmTokens/{uid}/{token}: true) — one
    // entry per registered device, owner-only. Read by the sendPushOnNotification
    // Cloud Function via the Admin SDK, which bypasses these rules entirely;
    // this only governs the client's own register/unregister writes.
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$token": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === true || newData.val() === null"
        }
      }
    },

    // ── Trade offers (tradeOffers/{toUid}/{tradeId}) — mailbox at the
    // recipient, same shape of idea as notifications/friendRequests. Only the
    // sender (an existing friend of the recipient) can create one, starting
    // 'pending'; only the recipient can flip it to 'accepted'/'declined',
    // only the sender can flip it to 'cancelled', and fromUid can never
    // change on an update (blocks spoofing an existing offer's origin).
    // Either side can delete their own copy outright. The actual card/coin
    // transfer on acceptance is NOT done here — see resolveTrade in
    // functions/index.js, which re-validates and moves everything
    // server-side via the Admin SDK (these rules only gate the offer
    // record itself, never the economic outcome).
    "tradeOffers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$tradeId": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === data.child('fromUid').val())",
          ".write": "auth != null && ((!data.exists() && newData.child('fromUid').val() === auth.uid && newData.child('status').val() === 'pending' && root.child('friends').child($uid).child(auth.uid).exists()) || (data.exists() && newData.val() === null && (auth.uid === $uid || auth.uid === data.child('fromUid').val())) || (data.exists() && data.child('status').val() === 'pending' && newData.child('fromUid').val() === data.child('fromUid').val() && ((auth.uid === $uid && (newData.child('status').val() === 'accepted' || newData.child('status').val() === 'declined')) || (auth.uid === data.child('fromUid').val() && newData.child('status').val() === 'cancelled'))))",
          ".validate": "newData.val() === null || (newData.hasChildren(['fromUid','fromPseudo','offerCardIds','requestCardIds','offerCoins','requestCoins','status','createdAt']) && newData.child('fromPseudo').val().length <= 12 && newData.child('offerCoins').isNumber() && newData.child('offerCoins').val() >= 0 && newData.child('requestCoins').isNumber() && newData.child('requestCoins').val() >= 0 && newData.child('status').val().matches(/^(pending|accepted|declined|cancelled|completed|failed)$/) && newData.child('createdAt').isNumber())"
        }
      }
    },

    // ── Sender-owned mirror of outgoing trade offers (tradeOffersSent/{fromUid}/{tradeId}).
    // tradeOffers/{toUid}/{tradeId} above lives at the RECIPIENT's uid, so the
    // sender has no query-able path to list "my pending outgoing offers" —
    // this lightweight pointer (same tradeId, plus toUid/toPseudo) is what
    // the "Échanges en cours" list in SocialScreen reads. Owner-only; the
    // resolveTrade Cloud Function updates/removes it via the Admin SDK once
    // the real tradeOffers entry resolves, since the recipient's own client
    // can't write into the sender's uid path.
    "tradeOffersSent": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$tradeId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === null || (newData.hasChildren(['toUid','toPseudo','status','createdAt']) && newData.child('toPseudo').val().length <= 12)"
        }
      }
    },

    // ── Online match rooms and matchmaking queue. Deliberately NOT uid-gated:
    // anonymous (logged-out) online play is a supported feature, and a room
    // is a shared secret (the 6-character code) rather than an owned
    // resource — anyone who has the code is meant to be able to join it.
    // The practical mitigation is the code space (32^6 ≈ 1.07B combinations)
    // and each room's short lifetime, not an auth check. If anonymous play
    // is ever dropped, tighten this to hostUid/guestUid-based access.
    //
    // .read/.write are scoped to $code (not the bare "rooms"/"matchmaking"
    // collections) specifically so a client can never dump/enumerate every
    // active room or the whole matchmaking queue in one request — the app
    // itself never reads those bare paths, only rooms/{code} and
    // matchmaking/waiting|results/{id}, so this is free hardening.
    // .validate rejects malformed/garbage payloads (wrong shape, a room code
    // outside genRoomCode()'s alphabet) — cheap insurance against a script
    // flooding the database with junk nodes instead of real game rooms.
    "rooms": {
      "$code": {
        ".read": true,
        ".write": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/)",
        ".validate": "newData.hasChildren(['state','player2Joined','createdAt']) && newData.child('player2Joined').isBoolean() && newData.child('createdAt').isNumber()"
      }
    },
    "matchmaking": {
      "waiting": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['id','ts']) && newData.child('id').isString() && newData.child('ts').isNumber()"
      },
      "results": {
        "$id": {
          ".read": true,
          ".write": true,
          ".validate": "newData.hasChildren(['code','at']) && newData.child('code').val().matches(/^[A-HJ-NP-Z2-9]{6}$/) && newData.child('at').isNumber()"
        }
      }
    },

    // Deny everything else by default.
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
