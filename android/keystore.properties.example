# Copy this file to android/keystore.properties (gitignored) and fill in the
# real values for the keystore already used to sign the published
# com.linereve.chartalogica.twa Play Store listing. Do NOT generate a new
# keystore here — a different signing key produces a build Google treats as a
# different app, breaking the update path for existing installs.
storeFile=../android.keystore
storePassword=CHANGE_ME
keyAlias=android
keyPassword=CHANGE_ME
# Optional. Only needed if signing fails with a DerInputStream/ASN.1 parsing
# error (Gradle guessed the wrong format) — set to JKS or PKCS12 to match
# whatever your actual android.keystore file is. Check with:
#   keytool -list -v -keystore android.keystore -storetype JKS
#   keytool -list -v -keystore android.keystore -storetype PKCS12
# whichever command doesn't error out (after entering the real password) tells
# you the right value.
storeType=CHANGE_ME
